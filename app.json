{
  "expo": {
    "name": "permisoUbicacion",
    "slug": "permisoUbicacion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.edu.utp.permisoubicacion",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Se usa tu ubicación para mostrar contenido local."
      }
    },
    "android": {
      "package": "pe.edu.utp.permisoubicacion",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
